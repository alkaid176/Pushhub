<?xml version="1.0" encoding="utf-8"?>
<!-- MainActivity 布局（06-06 Task 2，D-81/D-83/SC2 锁定）。
     结构（自上而下）：
      1. 权限被拒常驻横幅（Material Banner「消息不会提醒 · 点击开启」——点击跳
         ACTION_APP_NOTIFICATION_SETTINGS；绑定 ChannelHub.notificationsBlocked，
         SC2 锁定行为：拒绝不阻断连接，但界面常驻提醒）；
      2. 顶部连接状态条（MaterialCardView 内 TextView——当前频道状态：
         在线/重连中+倒计时，D-81）；
      3. 消息区容器（本 plan 直接承载单个 MessageFragment；06-07 替换为
         ViewPager2 多频道化——容器 ID message_container 保持稳定）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 权限被拒横幅（SC2 锁定：默认隐藏，NotificationsBlocked 为真时显示） -->
    <com.google.android.material.banner.Banner
        android:id="@+id/notification_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <TextView
            android:id="@+id/banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:text="消息不会提醒——通知权限被拒绝"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Button
            android:id="@+id/banner_action"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="点击开启" />
    </com.google.android.material.banner.Banner>

    <!-- 顶部连接状态条（D-81：当前频道状态常驻可见） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="…"
            android:textAppearance="?attr/textAppearanceLabelLarge" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 消息区容器（ID 稳定——06-07 替换承载为 ViewPager2） -->
    <FrameLayout
        android:id="@+id/message_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
