<?xml version="1.0" encoding="utf-8"?>
<!-- MainActivity 布局（06-06 Task 2 → 06-07 Task 2 tab 化，D-80/D-81/D-83）。
     结构（自上而下）：
      1. 权限被拒常驻横幅（横排 LinearLayout「消息不会提醒 · 点击开启」——点击跳
         ACTION_APP_NOTIFICATION_SETTINGS；绑定 ChannelHub.notificationsBlocked，
         SC2 锁定行为：拒绝不阻断连接，但界面常驻提醒）；
      2. 顶部连接状态条（MaterialCardView 内 TextView——**当前显示频道**状态：
         在线/重连中+倒计时，D-81；tab 切换联动）；
      3. 频道 tab 栏（TabLayout——每频道一 tab 文本=频道名 + 末尾固定「+」项进
         频道管理页，D-80；未读角标 BadgeDrawable，D-81）；
      4. 消息区（ViewPager2 横滑承载 MessageFragment(channelId) per 配置频道，
         D-80——FragmentStateAdapter）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 权限被拒横幅（SC2 锁定：默认隐藏，NotificationsBlocked 为真时显示）。
         注：Material Components 无 Banner 控件（规范有、库未实现——真机装机
         首启 ClassNotFoundException 修复），用横排 LinearLayout 等价承载。 -->
    <LinearLayout
        android:id="@+id/notification_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:text="消息不会提醒——通知权限被拒绝"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Button
            android:id="@+id/banner_action"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="点击开启" />
    </LinearLayout>

    <!-- 顶部连接状态条（D-81：当前显示频道状态常驻可见——tab 切换联动） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="…"
            android:textAppearance="?attr/textAppearanceLabelLarge" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 频道 tab 栏（D-80：频道名 tab + 末尾固定「+」；D-81：未读角标） -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/channel_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="scrollable"
        app:tabGravity="start" />

    <!-- 消息区（06-07：ViewPager2 每频道一 MessageFragment 实例，横滑切换） -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/channel_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
